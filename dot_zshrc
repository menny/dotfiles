function adb_screenshot() {
  local target_file="${1:-"$(mktemp).png"}"
  local remote_target="/sdcard/screenshot_$RANDOM_$RANDOM.png"

  /Users/mennyevendanan/Library/Android/sdk/platform-tools/adb shell screencap -p "$remote_target"
  /Users/mennyevendanan/Library/Android/sdk/platform-tools/adb pull "$remote_target" "$target_file"
  /Users/mennyevendanan/Library/Android/sdk/platform-tools/adb shell rm "$remote_target"
  echo "Screenshot available at $target_file"
}
